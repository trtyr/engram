# engram 部署环境变量样例
# 复制为 .env 后修改全部 change-me 项。

# --- PostgreSQL ---
POSTGRES_USER=agent
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=engram

# --- 应用 ---
# 管理员密码（Web UI 登录，Phase 1 生效）
AGENT_MEMORY_ADMIN_PASSWORD=change-me-admin-password

# 密钥加密主密钥：32 字节随机 hex（64 个字符）。生成：
#   openssl rand -hex 32
# 丢失后已存的 LLM provider key 将无法解密，需重新录入。
AGENT_MEMORY_MASTER_KEY=change-me-openssl-rand-hex-32

# 日志级别（可选）
RUST_LOG=info

# 宿主机暴露端口（可选，默认 8080）
AGENT_MEMORY_PORT=8080

# MCP（可选）：远程部署时放开 Host 白名单（默认仅 loopback，防 DNS rebinding）
# AGENT_MEMORY_MCP_ALLOWED_HOSTS=mem.example.com,mem.example.com:8080

# 检索：FTS 零命中时向量兜底的余弦距离上限（按 embedding 模型调整；默认 0.45）
# AGENT_MEMORY_VEC_FALLBACK_MAX_DISTANCE=0.45
# 兜底相对间隔：兜底候选只保留与最近邻距离差 ≤ 此值的项（默认 0.15）
# AGENT_MEMORY_VEC_FALLBACK_RELATIVE_MARGIN=0.15

# 查询侧嵌入指令（Qwen3-Embedding 等非对称检索模型必须设置，否则跨语言/短查询召回退化；
# bge-m3 等对称模型不设置）
# AGENT_MEMORY_EMBED_QUERY_INSTRUCTION=Instruct: Given a search query about the user, retrieve the relevant user memory entries

# embedding 向量维度（R11，可选；默认 1024 = 既有表列 vector(1024)）。
# 必须与表列维度一致——不一致服务拒绝启动（改维度需迁移改列 + 全量重嵌入，当前不支持自动重嵌入）
# AGENT_MEMORY_EMBEDDING_DIMENSIONS=1024

# Prometheus /metrics 端点（R10，可选；默认开——设为 0 关闭端点与指标记录）
# AGENT_MEMORY_METRICS=1

# job per-kind 并发上限（R12，可选；格式 kind:cap,kind:cap——cap 不超过全局并发）。
# 不配置 = 全部走全局并发（默认 4）。LLM 重任务建议 1-2，防蒸馏/wiki generate 挤占轻任务：
# AGENT_MEMORY_JOB_CONCURRENCY=wiki_generate:1,wiki_analyze:2,wiki_lint_deep:1,organize_scenarios:1
